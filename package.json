{
  "name": "overleaf-web-mcp",
  "version": "0.1.0",
  "description": "An unofficial MCP server for Overleaf web projects and review comments.",
  "author": "Mohammad Askari",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mhmdaskari/overleaf-web-mcp.git"
  },
  "homepage": "https://github.com/mhmdaskari/overleaf-web-mcp#readme",
  "bugs": {
    "url": "https://github.com/mhmdaskari/overleaf-web-mcp/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "overleaf-web-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "docs/assets/overleaf-web-mcp-workflow.webp",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "proper-lockfile": "^4.1.2",
    "tough-cookie": "^6.0.2",
    "ws": "^8.21.1",
    "zod": "^4.3.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^20.19.27",
    "@types/proper-lockfile": "^4.1.4",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.54.0",
    "vitest": "^4.1.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "login": "node dist/cli.js login",
    "start": "node dist/cli.js",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check && npm run lint && npm test"
  },
  "keywords": [
    "mcp",
    "overleaf",
    "latex",
    "comments"
  ]
}
